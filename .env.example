# Example environment configuration
# Copy this file to .env and adjust values as needed

# Server URL for socket.io connection
VITE_SERVER_URL=http://localhost:3001

# Development settings
VITE_NODE_ENV=development
VITE_DEBUG=true

# Game configuration overrides (optional)
# VITE_MAX_GAME_LENGTH=50
# VITE_MATRIX_SIZE=15

# Server-only: OpenAI configuration
# Provide your OpenAI API key to enable GPT/VLM agents.
OPENAI_API_KEY=your_openai_api_key_here

# VLM provider selector (default). gameConfig.agent.vlm.provider overrides per-request.
# Accepted: 'openai' | 'google'
VLM_PROVIDER=openai

# Server-only: Google Generative Language API (free tier) for Gemma/Gemini VLMs.
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_VLM_MODEL=gemini-2.5-flash

# Google free-tier rate shaping (much lower than OpenAI's paid tier)
GOOGLE_VLM_TARGET_RPM=25
GOOGLE_VLM_TARGET_TPM=120000

# OpenAI model used for both GPT and OpenAI VLM routes
GPT_API_MODEL=gpt-4o-mini

# VLM simulation / rate shaping (server reads these on each request after .env load)
# Tier 1 safe defaults: ~80% of 500 RPM / 200K TPM
VLM_TARGET_RPM=400
VLM_TARGET_TPM=160000
# Cap completion tokens for vision chat (base VLM vs ToM JSON)
VLM_MAX_OUTPUT_TOKENS=8
VLM_TOM_MAX_OUTPUT_TOKENS=80

# Per-trial VLM rate-limit telemetry in model-exp runs (orchestrator + run_summary when set)
ENABLE_VLM_DEBUG=false

# Enable detailed GPT logs on the server (prompt, matrix, outputs)
# Accepted truthy values: true, 1, yes, on (case-insensitive)
GPT_DEBUG=false
ENABLE_GPT_DEBUG=false
