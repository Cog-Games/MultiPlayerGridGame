# Put real keys in gameCode/.env, not in git.

# Claude / Anthropic
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-api-your-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI alternative
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4.1-mini

# Optional: Google Apps Script web app used for cell-phone Stag Hunt round uploads.
# Defaults to the legacy gridGame upload endpoint when omitted.
# GOOGLE_DRIVE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
